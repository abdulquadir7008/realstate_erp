  priority       TicketPriority @default(MEDIUM)
  status         TicketStatus   @default(NEW)
  assignedTo     String?        @db.Uuid
  slaDueAt       DateTime?
  resolutionNotes String?
  closedAt       DateTime?
  createdBy      String?        @db.Uuid
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  messages TicketMessage[]

  @@unique([organizationId, ticketNumber])
  @@index([organizationId, status])
  @@index([organizationId, assignedTo])
}

model TicketMessage {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId    String   @db.Uuid
  authorId    String?  @db.Uuid
  authorRole  String   @default("STAFF") // STAFF | CUSTOMER
  body        String
  attachments Json     @default("[]")
  createdAt   DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

model Handover {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid
  bookingId      String   @db.Uuid
  scheduledAt    DateTime?
  status         String   @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED
  checklist      Json     @default("[]") // [{item, done, remarks}]
  handedOverAt   DateTime?
  notes          String?
  createdAt      DateTime @default(now())

  @@unique([bookingId])
  @@index([organizationId, status])
}

// ============================================================ Automation & platform

model WorkflowDefinition {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid
  name           String
  code           String
  trigger        WorkflowTrigger
  conditions     Json            @default("[]") // [{field, op, value}]
  actions        Json            @default("[]") // [{type, config}]
  isActive       Boolean         @default(true)
  runCount       Int             @default(0)
  lastRunAt      DateTime?
  createdBy      String?         @db.Uuid
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  executions WorkflowExecution[]

  @@unique([organizationId, code])
  @@index([organizationId, trigger, isActive])
}

model WorkflowExecution {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid
  workflowId    String         @db.Uuid
  triggerEvent  String
  context       Json           @default("{}")
  status        WorkflowStatus @default(PENDING)
  startedAt     DateTime?
  finishedAt    DateTime?
  error         String?
  log           Json           @default("[]")
  createdAt     DateTime       @default(now())

  workflow WorkflowDefinition @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId, status])
  @@index([organizationId, createdAt])
}

model AuditLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid
  userId         String?  @db.Uuid
  actorEmail     String?
  action         String // CREATE | UPDATE | DELETE | LOGIN | EXPORT | APPROVE ...
  entityType     String
  entityId       String?
  description    String?
  changes        Json     @default("{}")
  ipAddress      String?
  userAgent      String?
  severity       String   @default("INFO") // INFO | WARN | CRITICAL
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
  @@index([userId, createdAt])
}

model Notification {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid
  userId         String?           @db.Uuid
  roleCode       String?
  type           String // generic bucket e.g. LEAD_ASSIGNED, PAYMENT_RECEIVED
  title          String
  body           String?
  data           Json              @default("{}")
  channel        NotificationChannel @default(IN_APP)
  readAt         DateTime?
  sentAt         DateTime?
  createdAt      DateTime          @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([userId, readAt])
}

model Counter {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid
  scope          String // LEAD | BOOKING | DEMAND | RECEIPT | INVOICE | TICKET | PO | GRN | CUSTOMER | EXPENSE
  period         String // e.g. 2026-10 or ALL
  value          Int      @default(0)

  @@unique([organizationId, scope, period])
}

model ImportJob {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid
  type           String // LEAD | CUSTOMER | VENDOR
  storageKey     String
  status         ImportStatus @default(PENDING)
  totalRows      Int          @default(0)
  succeeded      Int          @default(0)
  failed         Int          @default(0)
  errors         Json         @default("[]")
  createdBy      String?      @db.Uuid
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, createdAt])
}

model WebhookEvent {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?  @db.Uuid
  provider       String
  eventId        String
  signature      String?
  payload        Json
  status         String   @default("RECEIVED") // RECEIVED | PROCESSED | FAILED | DUPLICATE
  error          String?
  receivedAt     DateTime @default(now())
  processedAt    DateTime?

  @@unique([provider, eventId])
  @@index([organizationId, receivedAt])
}

model AiUsage {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid
  userId         String?  @db.Uuid
  feature        String // CRM_ASSISTANT | BUSINESS_ASSISTANT | DOC_ASSISTANT | FORECAST
  tokensIn       Int      @default(0)
  tokensOut      Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
}

model AiConversation {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid
  userId         String   @db.Uuid
  title          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  messages AiMessage[]

  @@index([organizationId, userId])
}

model AiMessage {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid
  conversationId String   @db.Uuid
  role           String // user | assistant | tool
  content        String
  meta           Json     @default("{}")
  createdAt      DateTime @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
