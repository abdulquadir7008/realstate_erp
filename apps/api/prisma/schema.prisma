// ============================================================ Bookings & sales

model Booking {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid
  bookingNumber      String
  projectId          String        @db.Uuid
  unitId             String        @db.Uuid
  customerId         String        @db.Uuid
  leadId             String?       @db.Uuid
  salesExecutiveId   String?       @db.Uuid
  brokerId           String?       @db.Uuid
  paymentPlanId      String?       @db.Uuid
  status             BookingStatus @default(DRAFT)
  bookingDate        DateTime      @default(now())
  reservedUntil      DateTime?
  basePrice          Decimal       @default(0) @db.Decimal(16, 2)
  negotiatedPrice    Decimal       @default(0) @db.Decimal(16, 2)
  discountAmount     Decimal       @default(0) @db.Decimal(16, 2)
  discountApprovedBy String?       @db.Uuid
  otherCharges       Json          @default("[]")
  totalPrice         Decimal       @default(0) @db.Decimal(16, 2)
  agreementDate      DateTime?
  possessionDate     DateTime?
  cancelledAt        DateTime?
  cancelReason       String?
  notes              String?
  createdBy          String?       @db.Uuid
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  deletedAt          DateTime?

  project    Project    @relation(fields: [projectId], references: [id])
  unit       Unit       @relation(fields: [unitId], references: [id])
  customer   Customer   @relation(fields: [customerId], references: [id])
  paymentPlan PaymentPlan? @relation(fields: [paymentPlanId], references: [id])
  history    BookingStatusHistory[]
  demands    PaymentDemand[]
  payments   Payment[]
  receipts   Receipt[]

  @@unique([organizationId, bookingNumber])
  @@index([organizationId, status])
  @@index([customerId])
  @@index([unitId])
}

model BookingStatusHistory {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId  String        @db.Uuid
  fromStatus BookingStatus?
  toStatus   BookingStatus
  remarks    String?
  changedBy  String?       @db.Uuid
  createdAt  DateTime      @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
}

// ============================================================ Finance

model PaymentPlan {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid
