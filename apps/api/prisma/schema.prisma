// Real Estate ERP — complete data model (multi-tenant, shared-db + tenant_id isolation)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================ enums

enum Scope {
  SAAS
  TENANT
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum OrgStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
  CANCELLED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

