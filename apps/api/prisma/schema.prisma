// ============================================================ SaaS core

model Plan {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String   @unique
  name            String
  description     String?
  priceMonthly    Decimal  @default(0) @db.Decimal(12, 2)
  priceYearly     Decimal  @default(0) @db.Decimal(12, 2)
  currency        String   @default("INR")
  maxUsers        Int      @default(5)
  maxProjects     Int      @default(2)
  storageQuotaMb  Int      @default(1024)
  maxAiRequests   Int      @default(50)
  trialDays       Int      @default(14)
  features        Json     @default("{}") // advancedReports, automation, apiAccess, mobileAccess, whatsapp
  isDefault       Boolean  @default(false)
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subscriptions Subscription[]
}

model Organization {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  slug           String    @unique
  legalName      String?
  email          String
  phone          String?
  website        String?
  logoUrl        String?
  address        String?
  city           String?
  state          String?
  country        String    @default("India")
  pincode        String?
  gstin          String?
  pan            String?
  status         OrgStatus @default(PENDING)
  settings       Json      @default("{}") // currency, locale, tax, fiscal year, branding, notifications
  trialEndsAt    DateTime?
  approvedAt     DateTime?
  approvedBy     String?   @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  users          User[]
  roles          Role[]
  branches       Branch[]
  departments     Department[]
  projects       Project[]
  subscriptions  Subscription[]
  saasInvoices   SaaSInvoice[]
  auditLogs      AuditLog[]
}

model Subscription {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid
  planId            String             @db.Uuid
  status            SubscriptionStatus @default(TRIALING)
  billingCycle      BillingCycle       @default(MONTHLY)
  pricePaid         Decimal            @default(0) @db.Decimal(12, 2)
  currency          String             @default("INR")
  startsAt          DateTime           @default(now())
  currentPeriodEnd  DateTime
  trialEndsAt       DateTime?
  cancelledAt       DateTime?
  cancelReason      String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id])

  invoices SaaSInvoice[]

  @@index([organizationId, status])
}

model SaaSInvoice {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid
  subscriptionId String   @db.Uuid
  number         String   @unique
  amount         Decimal  @db.Decimal(12, 2)
  currency       String   @default("INR")
  status         String   @default("PAID") // PAID | PENDING | FAILED
  paidAt         DateTime?
  periodStart    DateTime
  periodEnd      DateTime
  paymentRef     String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

// ============================================================ RBAC & identity

model User {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid
  scope          Scope      @default(TENANT)
  email          String     @unique
  phone          String?
  passwordHash   String
  firstName      String
  lastName       String?
  avatarUrl      String?
  status         UserStatus @default(ACTIVE)
  designation    String?
  branchId       String?    @db.Uuid
  departmentId   String?    @db.Uuid
  mfaEnabled     Boolean    @default(false)
  mfaSecret      String?
  lastLoginAt    DateTime?
  invitedBy      String?    @db.Uuid
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roles        UserRole[]
  refreshTokens RefreshToken[]
  ledgers       LedgerEntry[]  @relation("ledgerCreator")
  notifications  Notification[]

  @@index([organizationId, status])
}

model Role {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?  @db.Uuid // null => system/global role template
  code           String
  name           String
  description    String?
  isSystem       Boolean  @default(false)
  isCustomer     Boolean  @default(false)
  scope          Scope    @default(TENANT)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions   RolePermission[]
  users         UserRole[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Permission {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String  @unique // e.g. project:create
  module      String
  action      String
  description String?

  roles RolePermission[]
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId   String   @db.Uuid
  roleId   String   @db.Uuid
  orgId    String?  @db.Uuid
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([orgId])
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LoginActivity {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?  @db.Uuid
  email     String
  ip        String?
  userAgent String?
  success   Boolean
  reason    String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Invitation {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid
  email          String
  roleCode       String
  token          String    @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  invitedBy      String    @db.Uuid
  createdAt      DateTime  @default(now())

  @@index([organizationId, email])
}

// ============================================================ Org structure

model Branch {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid
  name           String
  code           String
  address        String?
  city           String?
  phone          String?
  email          String?
  isHeadquarters Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Department {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid
  name           String
  code           String
  headId         String?  @db.Uuid
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees     Employee[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model FinancialYear {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid
  name           String
  startDate      DateTime @db.Date
  endDate        DateTime @db.Date
  isCurrent      Boolean  @default(false)
  isLocked       Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@unique([organizationId, name])
  @@index([organizationId, isCurrent])
}

model TaxRate {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid
  name           String
  code           String
  percent        Decimal  @db.Decimal(5, 2)
  isDefault      Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@unique([organizationId, code])
  @@index([organizationId])
}

// ============================================================ People

model Employee {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid
  userId         String?  @db.Uuid
  employeeCode   String
  firstName      String
  lastName       String?
  email          String
  phone          String?
  departmentId   String?  @db.Uuid
  designation    String
  branchId       String?  @db.Uuid
  managerId      String?  @db.Uuid
  joinDate       DateTime @db.Date
  employmentType String   @default("FULL_TIME") // FULL_TIME | PART_TIME | CONTRACT
  status         String   @default("ACTIVE") // ACTIVE | ON_LEAVE | EXPIRED | TERMINATED
  baseSalary     Decimal  @default(0) @db.Decimal(12, 2)
  bankDetails    Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  department Department? @relation(fields: [departmentId], references: [id])
  attendance Attendance[]
  leaves     LeaveRequest[]

  @@unique([organizationId, employeeCode])
  @@unique([organizationId, email])
  @@index([organizationId, status])
}

model Attendance {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid
  employeeId   String         @db.Uuid
  date         DateTime       @db.Date
  status       AttendanceStatus @default(PRESENT)
  checkIn      DateTime?
  checkOut     DateTime?
  notes        String?
  createdAt    DateTime       @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([organizationId, date])
}

model LeaveRequest {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid
  employeeId     String      @db.Uuid
  type           String // ANNUAL | SICK | CASUAL | UNPAID
  startDate      DateTime    @db.Date
  endDate        DateTime    @db.Date
  days           Int
  reason         String
  status         LeaveStatus @default(PENDING)
  approverId     String?     @db.Uuid
  decidedAt      DateTime?
  createdAt      DateTime    @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([employeeId])
}

// ============================================================ Projects

model Project {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid
  branchId       String?       @db.Uuid
  code           String
  name           String
  description    String?
  type           ProjectType   @default(RESIDENTIAL)
  status         ProjectStatus @default(PLANNING)
  address        String?
  city           String?
  state          String?
  latitude       Decimal?      @db.Decimal(10, 7)
  longitude      Decimal?      @db.Decimal(10, 7)
  totalBudget    Decimal       @default(0) @db.Decimal(16, 2)
  startDate      DateTime?     @db.Date
  endDate        DateTime?     @db.Date
  imageUrl       String?
  managerId      String?       @db.Uuid
  createdBy      String?       @db.Uuid
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  buildings     Building[]
  milestones    ProjectMilestone[]
  units         Unit[]
  tasks         ConstructionTask[]
  siteReports   DailySiteReport[]
  bookings      Booking[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
}

model ProjectMilestone {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid
  projectId       String       @db.Uuid
  name            String
  description     String?
  order           Int          @default(0)
  dueDate         DateTime?    @db.Date
  status          String       @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED | DELAYED
  progressPercent Int          @default(0)
  completedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, order])
}

// ============================================================ Inventory (property)

model Building {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid
  projectId      String      @db.Uuid
  name           String
  code           String
  type           BuildingType @default(TOWER)
  totalFloors    Int         @default(1)
  description    String?
  order          Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  floors  Floor[]
  units   Unit[]

  @@unique([projectId, code])
  @@index([organizationId])
}

model Floor {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid
  buildingId     String   @db.Uuid
  projectId      String   @db.Uuid
  label          String // "G", "1", "2", "GROUND"
  floorNumber    Int      @default(0)
  order          Int      @default(0)
  createdAt      DateTime @default(now())

  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  units    Unit[]

  @@unique([buildingId, label])
  @@index([projectId])
}

model Unit {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid
  projectId        String     @db.Uuid
  buildingId       String     @db.Uuid
  floorId          String     @db.Uuid
  unitNumber       String
  type             UnitType   @default(APARTMENT)
  configuration    String? // "2BHK", "3BHK+2T", "PLOT-1500"
  carpetArea       Decimal?   @db.Decimal(10, 2)
  builtUpArea      Decimal?   @db.Decimal(10, 2)
  superBuiltUpArea Decimal?   @db.Decimal(10, 2)
  basePrice        Decimal    @default(0) @db.Decimal(16, 2)
  pricePerSqft     Decimal?   @db.Decimal(10, 2)
  additionalCharges Json       @default("[]") // [{name, amount, taxable}]
  parkingSlots     String[]   @default([])
  facing           String?
  status           UnitStatus @default(AVAILABLE)
  heldUntil        DateTime?
  version          Int        @default(0)
  notes            String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  deletedAt        DateTime?

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  floor    Floor   @relation(fields: [floorId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@unique([buildingId, unitNumber])
  @@index([organizationId, projectId, status])
  @@index([organizationId, status])
  @@index([status])
}

// ============================================================ CRM

model Lead {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid
  leadNumber     String
  name           String
  email          String?
  phone          String
  altPhone       String?
  city           String?
  source         LeadSource  @default(WEBSITE)
  status         LeadStatus  @default(NEW)
  propertyType   String?
  budgetMin      Decimal?    @db.Decimal(16, 2)
  budgetMax      Decimal?    @db.Decimal(16, 2)
  projectId      String?     @db.Uuid
  branchId       String?     @db.Uuid
  assignedTo     String?     @db.Uuid
  score          Int         @default(0)
  notes          String?
  lostReason     String?
  duplicateOfId  String?     @db.Uuid
  nextFollowUpAt DateTime?
  lastActivityAt DateTime?
  convertedAt    DateTime?
  customerId     String?     @db.Uuid
  createdBy      String?     @db.Uuid
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?

  activities LeadActivity[]
  followUps  FollowUp[]

  @@index([organizationId, status])
  @@index([organizationId, assignedTo])
  @@index([organizationId, createdAt])
}

model LeadActivity {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid
  leadId      String       @db.Uuid
  type        ActivityType @default(NOTE)
  direction   String? // INBOUND | OUTBOUND
  subject     String?
  content     String?
  durationSec Int?
  occurredAt  DateTime     @default(now())
  createdBy   String?      @db.Uuid

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, occurredAt])
  @@index([organizationId, occurredAt])
}

model FollowUp {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid
  leadId         String   @db.Uuid
  scheduledAt    DateTime
  type           String   @default("CALL") // CALL | MEETING | EMAIL | WHATSAPP | SITE_VISIT
  notes          String?
  status         String   @default("PENDING") // PENDING | DONE | MISSED | CANCELLED
  assignedTo     String?  @db.Uuid
  completedAt    DateTime?
  createdBy      String?  @db.Uuid
  createdAt      DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([organizationId, scheduledAt, status])
