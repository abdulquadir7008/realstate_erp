# ---- Shared ----
NODE_ENV=development
TZ=UTC

# ---- API ----
API_PORT=4010
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---- Database ----
DATABASE_URL=postgresql://realestate:realestate@localhost:5434/realestate_erp?schema=public
DIRECT_URL=postgresql://realestate:realestate@localhost:5434/realestate_erp?schema=public

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
JOBS_ENABLED=true

# ---- Storage (local | s3 | r2) ----
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage/uploads
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- Payments (Razorpay) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Email ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="RealEstate ERP <no-reply@realestate.local>"

# ---- AI (optional, Hugging Face OpenAI-compatible) ----
AI_ENABLED=false
AI_BASE_URL=https://router.huggingface.co/v1
AI_API_KEY=
AI_MODEL=HuggingFaceH4/zephyr-7b-beta

# ---- Web ----
NEXT_PUBLIC_API_URL=http://localhost:4010/api/v1
NEXT_PUBLIC_APP_NAME=PropERP
